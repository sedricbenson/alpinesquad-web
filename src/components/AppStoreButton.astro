---
/**
 * Official Apple "Download on the App Store" badge (black / preferred).
 * Artwork from Apple Marketing Guidelines — do not invent a custom button.
 *
 * https://developer.apple.com/app-store/marketing/guidelines/
 */
interface Props {
  href: string;
  /** Accessible name; also used as img alt */
  label?: string;
  /**
   * Badge height in CSS px. Official artwork is 40 tall × ~120 wide;
   * width scales to preserve aspect ratio. Prefer ≥40 when space allows.
   */
  height?: number;
}

const {
  href,
  label = 'Download on the App Store',
  height = 40,
} = Astro.props;

// Official SVG viewBox: 119.66407 × 40
const width = Math.round((height * 119.66407) / 40);
---

<a
  href={href}
  class="appstore-badge"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <img
    src="/badges/download-on-the-app-store.svg"
    alt={label}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
</a>

<style>
  .appstore-badge {
    display: inline-block;
    line-height: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .appstore-badge:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  .appstore-badge img {
    display: block;
    width: auto;
    height: auto;
  }
</style>
